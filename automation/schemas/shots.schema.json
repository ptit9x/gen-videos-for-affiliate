{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Flow episode input v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "episode_id",
    "revision",
    "approved_for_generation",
    "shots"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "episode_id": {
      "type": "string",
      "pattern": "^ep[0-9]{3,}$"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "approved_for_generation": {
      "const": true
    },
    "shots": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "shot_id",
          "prompt_file",
          "prompt_sha256",
          "reference_files",
          "reference_sha256",
          "requested_duration_seconds",
          "aspect_ratio",
          "requested_takes"
        ],
        "properties": {
          "shot_id": {
            "type": "string",
            "pattern": "^sh[0-9]{3}$"
          },
          "prompt_file": {
            "type": "string",
            "minLength": 1
          },
          "prompt_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "reference_files": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            },
            "maxItems": 3
          },
          "reference_sha256": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "requested_duration_seconds": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "aspect_ratio": {
            "enum": [
              "9:16",
              "16:9"
            ]
          },
          "requested_takes": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    }
  }
}
