[
 {
  "start": 0.0,
  "end": 0.62,
  "text": "Em hỏi em"
 },
 {
  "start": 0.62,
  "end": 2.22,
  "text": "Anh yêu em hỏi là yêu quân nhỏ đó"
 },
 {
  "start": 2.68,
  "end": 3.48,
  "text": "Nhỏ đó nhỏ nào"
 },
 {
  "start": 3.86,
  "end": 4.18,
  "text": "Tạ"
 },
 {
  "start": 4.68,
  "end": 6.36,
  "text": "Không cửa con đã thay đổi rồi"
 },
 {
  "start": 6.36,
  "end": 6.96,
  "text": "Anh thay đổi gì"
 },
 {
  "start": 6.96,
  "end": 8.82,
  "text": "Anh quay tâm với con nhỏ đó là con nhỏ nào"
 },
 {
  "start": 8.82,
  "end": 9.22,
  "text": "Hả?"
 },
 {
  "start": 9.54,
  "end": 11.12,
  "text": "Anh không quay tâm trình trạng của hai đứa mình đâu"
 },
 {
  "start": 11.12,
  "end": 12.8,
  "text": "Em hỏi một lần nữa anh còn yêu em không"
 },
 {
  "start": 13.22,
  "end": 14.28,
  "text": "Anh còn yêu em"
 },
 {
  "start": 14.28,
  "end": 16.28,
  "text": "Vậy dưới em dưới con nhỏ đó anh chọn ai"
 },
 {
  "start": 16.28,
  "end": 17.44,
  "text": "Anh có biết nhỏ đó là ai đâu"
 },
 {
  "start": 18.06,
  "end": 18.52,
  "text": "Tạng nữa"
 },
 {
  "start": 18.52,
  "end": 20.38,
  "text": "Anh còn biết con nhỏ lại anh quay tâm làm cái gì"
 },
 {
  "start": 20.38,
  "end": 21.76,
  "text": "Cho bây giờ anh không cần quang tâm"
 },
 {
  "start": 21.76,
  "end": 22.84,
  "text": "Anh không cần hỏi thâm luôn"
 },
 {
  "start": 22.84,
  "end": 24.74,
  "text": "Bây giờ cho dù anh có bao nhiêu con nhỏ cho anh nữa"
 },
 {
  "start": 24.74,
  "end": 25.88,
  "text": "Anh dưới con nhỏ như em"
 },
 {
  "start": 26.52,
  "end": 28.0,
  "text": "Quan nhiều con nhỏ đó em hãy gì"
 },
 {
  "start": 28.0,
  "end": 28.86,
  "text": "Anh không con nhỏ nào"
 },
 {
  "start": 28.86,
  "end": 29.58,
  "text": "Lỡ có"
 },
 {
  "start": 29.58,
  "end": 30.7,
  "text": "Anh ăn không có"
 },
 {
  "start": 30.7,
  "end": 32.02,
  "text": "Anh ăn không lỡ có mà"
 },
 {
  "start": 32.02,
  "end": 33.6,
  "text": "Đó bây giờ cho là anh có luôn"
 },
 {
  "start": 33.6,
  "end": 34.8,
  "text": "Thì anh dính còn như em"
 },
 {
  "start": 34.8,
  "end": 35.86,
  "text": "Vậy là anh có"
 },
 {
  "start": 35.86,
  "end": 36.66,
  "text": "Vậy nè đi"
 },
 {
  "start": 37.48,
  "end": 38.44,
  "text": "Vậy mẹ đi"
 },
 {
  "start": 38.44,
  "end": 39.2,
  "text": "Ủa là sao"
 },
 {
  "start": 39.2,
  "end": 40.04,
  "text": "Tát quay vậy"
 },
 {
  "start": 40.04,
  "end": 41.48,
  "text": "Bây giờ thường nhận luôn à"
 },
 {
  "start": 41.48,
  "end": 42.66,
  "text": "Là tui yêu con nhỏ đó đó"
 },
 {
  "start": 42.66,
  "end": 43.56,
  "text": "Thì chó"
 },
 {
  "start": 44.74,
  "end": 46.8,
  "text": "Anh đưa nhỏ tui anh có con nhỏ đó"
 },
 {
  "start": 46.8,
  "end": 48.08,
  "text": "Hà con nhỏ đó là con nhỏ nào"
 },
 {
  "start": 48.08,
  "end": 50.72,
  "text": "Bây giờ con nhỏ đó cho dù đầu đường xó trở"
 },
 {
  "start": 51.16,
  "end": 52.5,
  "text": "Cùi đuôi sức mẹ"
 },
 {
  "start": 52.5,
  "end": 53.46,
  "text": "Không có đầu"
 },
 {
  "start": 53.46,
  "end": 54.62,
  "text": "Tui dính yêu con nhỏ đó"
 },
 {
  "start": 54.62,
  "end": 55.98,
  "text": "Tui tụi em đi xong"
 },
 {
  "start": 55.98,
  "end": 56.66,
  "text": "Dì giải đi"
 },
 {
  "start": 56.66,
  "end": 57.68,
  "text": "Nghĩ mẹ đi tá"
 },
 {
  "start": 57.68,
  "end": 58.92,
  "text": "Quả giá quán quán quán quán"
 },
 {
  "start": 58.92,
  "end": 60.02,
  "text": "Mẹ sao chưa đánh vậy"
 },
 {
  "start": 60.02,
  "end": 61.02,
  "text": "Quán quán quán quán"
 },
 {
  "start": 62.14,
  "end": 62.88,
  "text": "Được trời"
 }
]