{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 2
    },
    "episode_id": {
      "type": "string",
      "pattern": "^ep[0-9]{3,}$"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "title": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "editorial_status": {
      "enum": [
        "draft",
        "script_approved",
        "generating",
        "clips_generated_pending_dub",
        "editing",
        "qc",
        "ready_to_publish",
        "published"
      ]
    },
    "flow_project": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "generation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {
          "type": "string"
        },
        "agent": {
          "type": "boolean"
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "duration_seconds": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "aspect_ratio": {
          "type": "string"
        },
        "outputs": {
          "type": "integer",
          "minimum": 1
        },
        "last_frame": {
          "type": "null"
        }
      },
      "required": [
        "mode",
        "agent",
        "model",
        "duration_seconds",
        "aspect_ratio",
        "outputs",
        "last_frame"
      ]
    },
    "expected_source": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        },
        "fps": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "required": [
        "width",
        "height",
        "fps"
      ]
    },
    "export": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        },
        "fps": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "required": [
        "width",
        "height",
        "fps"
      ]
    },
    "target_duration_seconds": {
      "type": [
        "number",
        "null"
      ],
      "exclusiveMinimum": 0
    },
    "shots": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "shot_id": {
            "type": "string",
            "pattern": "^sh[0-9]{3}$"
          },
          "approved_for_generation": {
            "type": "boolean"
          },
          "dialogue": {
            "type": "string"
          },
          "image_prompt": {
            "anyOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "path": {
                    "type": "string",
                    "minLength": 1
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  }
                },
                "required": [
                  "path",
                  "sha256"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "motion_prompt": {
            "anyOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "path": {
                    "type": "string",
                    "minLength": 1
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  }
                },
                "required": [
                  "path",
                  "sha256"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "image_sources": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              },
              "required": [
                "path",
                "sha256"
              ]
            }
          },
          "first_frame": {
            "anyOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "path": {
                    "type": "string",
                    "minLength": 1
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  }
                },
                "required": [
                  "path",
                  "sha256"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "frame_status": {
            "enum": [
              "missing_local",
              "pending_review",
              "approved"
            ]
          },
          "flow_image_asset_id": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "takes": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "take_id": {
                  "type": "string",
                  "pattern": "^take[0-9]{3}$"
                },
                "clip_id": {
                  "anyOf": [
                    {
                      "type": "string",
                      "minLength": 1
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "status": {
                  "enum": [
                    "accepted_editorial",
                    "rejected_editorial",
                    "needs_review"
                  ]
                },
                "file": {
                  "anyOf": [
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "path": {
                          "type": "string",
                          "minLength": 1
                        },
                        "sha256": {
                          "type": "string",
                          "pattern": "^[a-f0-9]{64}$"
                        }
                      },
                      "required": [
                        "path",
                        "sha256"
                      ]
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "note": {
                  "type": "string"
                }
              },
              "required": [
                "take_id",
                "clip_id",
                "status",
                "file",
                "note"
              ]
            }
          }
        },
        "required": [
          "shot_id",
          "approved_for_generation",
          "dialogue",
          "image_prompt",
          "motion_prompt",
          "image_sources",
          "first_frame",
          "frame_status",
          "flow_image_asset_id",
          "takes"
        ]
      },
      "minItems": 1
    }
  },
  "required": [
    "schema_version",
    "episode_id",
    "revision",
    "title",
    "editorial_status",
    "flow_project",
    "generation",
    "expected_source",
    "export",
    "target_duration_seconds",
    "shots"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
